// Placement hologram, blocked position -- the dark ghost.
// Mirrors vanilla's dz\gear\camping\data\tent_medium_undeployable.rvmat. Note that
// vanilla signals "can't place here" by going DARK, not red, so this matches the
// rest of the game rather than inventing its own colour. Stages 1-6 are identical
// to the deployable pair; only the colour block and Stage7 differ.
ambient[] = { 0, 0, 0, 0.25 };
diffuse[] = { 0, 0, 0, 0.25 };
forcedDiffuse[] = { 0, 0, 0, 0 };
emmisive[] = { 0.04, 0.04, 0.04, 0.25 };
specular[] = { 0.275, 0.275, 0.275, 1 };
specularPower = 80;
PixelShaderID = "Super";
VertexShaderID = "Super";
class Stage1 {
	texture = "gebsfish\data\tools\fishmount_normals.paa";
	uvSource = "tex";
	class uvTransform {
		aside[] = { 1, 0, 0 };
		up[] = { 0, 1, 0 };
		dir[] = { 0, 0, 0 };
		pos[] = { 0, 0, 0 };
	};
};
