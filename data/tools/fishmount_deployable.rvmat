// Placement hologram, valid position -- the white ghost.
// Values and stage layout mirror vanilla's dz\gear\camping\data\tent_medium_deployable.rvmat
// so the plaque reads the same as every other placeable. Two things matter:
// forcedDiffuse must be WHITE (a tint here is what made this render green), and
// the shader must be "Super" with the full stage chain -- "Normal"/"Basic" with
// no stages loses the fresnel sheen that makes a hologram look like a hologram.
ambient[] = { 1, 1, 1, 1 };
diffuse[] = { 0.25, 0.25, 0.25, 1 };
forcedDiffuse[] = { 1, 1, 1, 1 };
emmisive[] = { 0.125, 0.125, 0.125, 1 };
specular[] = { 0.4, 0.4, 0.4, 1 };
specularPower = 50;
PixelShaderID = "Super";
VertexShaderID = "Super";
class Stage1 {
	texture = "gebsfish\data\tools\fishmount_normals.paa";
	uvSource = "tex";
	class uvTransform {
		aside[] = { 1, 0, 0 };
		up[] = { 0, 1, 0 };
		dir[] = { 0, 0, 0 };
		pos[] = { 0, 0, 0 };
	};
};
class Stage2 {
	texture = "#(argb,8,8,3)color(0.5,0.5,0.5,0.5,DT)";
	uvSource = "tex";
	class uvTransform {
		aside[] = { 1, 0, 0 };
		up[] = { 0, 1, 0 };
		dir[] = { 0, 0, 0 };
		pos[] = { 0, 0, 0 };
	};
};
